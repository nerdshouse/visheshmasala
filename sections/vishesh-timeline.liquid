{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

{% comment %}
  Our Journey. An alternating spine timeline: a vertical line down the
  middle with milestone cards stepping left and right off it, each with
  its year, an era motif and its copy.

  This replaces a sticky one-at-a-time stage. That mechanic worked, but
  its shape was the problem rather than its implementation: a single
  short milestone card held inside a viewport-tall stuck stage always
  leaves a large empty band, and every attempt to close it only moved
  the emptiness around - centre it and you get two cream bands, stretch
  the card and you get one white one. It also had to fight Dawn's
  reveal-on-scroll header for the top of the viewport, which is what
  cropped the card on phones.

  Laying the nine milestones out in flow removes the whole class of
  problem: there is no stage to fill, nothing is position:sticky, no
  scroll is taken from the user, and the section is exactly as tall as
  its content. It also suits the content better - a fifty year family
  history reads as one continuous line rather than nine slides a reader
  has to scrub through to see.

  Motion is limited to each item easing in as it scrolls into view, via
  the theme's existing data-animate="fade-up" hook, which is already
  gated on prefers-reduced-motion.
{% endcomment %}
<div class="vishesh-journey color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <header class="vishesh-journey__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vishesh-journey__eyebrow" data-animate="fade-up">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vishesh-journey__heading" data-animate="fade-up">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </header>

    <ol class="vishesh-journey__list" role="list">
      {%- for block in section.blocks -%}
        <li class="vishesh-journey__item" data-animate="fade-up" {{ block.shopify_attributes }}>
          <span class="vishesh-journey__node" aria-hidden="true">
            {%- render 'vishesh-timeline-icon', icon: block.settings.icon -%}
          </span>

          <article class="vishesh-journey__card">
            <span class="vishesh-journey__year">{{ block.settings.year }}</span>
            <p class="vishesh-journey__text">{{ block.settings.text }}</p>
          </article>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "Vishesh Timeline",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "1970 to today"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year" },
        { "type": "textarea", "id": "text", "label": "Text" },
        {
          "type": "select",
          "id": "icon",
          "label": "Era motif",
          "default": "tin",
          "info": "Line drawing shown in this milestone's node on the line.",
          "options": [
            { "value": "tin", "label": "Masala tin" },
            { "value": "factory", "label": "Production unit" },
            { "value": "cart", "label": "Bullock cart" },
            { "value": "people", "label": "Next generation" },
            { "value": "certificate", "label": "Certification" },
            { "value": "pack", "label": "Consumer pack" },
            { "value": "network", "label": "Distribution" },
            { "value": "star", "label": "New brand" },
            { "value": "facility", "label": "Modern facility" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vishesh Timeline",
      "blocks": [
        {
          "type": "milestone",
          "settings": { "year": "1970", "text": "Humble start with a small rented production unit at Udhna, Surat." }
        },
        {
          "type": "milestone",
          "settings": { "year": "1971", "text": "Extended our production unit, manufacturing only Hing for five years." }
        }
      ]
    }
  ]
}
{% endschema %}
