{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

{% comment %}
  Journey stage. One sticky stage holds while a tall wrapper scrolls
  past it, and the milestones advance one at a time inside that stage -
  the same mechanic as the reference, which uses a single
  `sticky top-0 h-screen` stage inside a 400vh parent rather than one
  sticky panel per milestone.

  An earlier version here gave every milestone its own sticky panel, so
  they stacked and slid over one another. That is a different effect,
  and not the one asked for - the stage is now singular and the
  milestones change within it.

  The hold is native CSS position:sticky, not a scripted pin: no
  spacer element, scroll is never taken from the user, and if the JS
  below never runs the section degrades to a plain readable list of all
  nine milestones (see .vishesh-timeline--live in the CSS - the
  swap-one-at-a-time behaviour is gated behind a class that only JS
  adds). That matters on this theme, where scripted pins have twice
  left this section's content stranded invisible.

  assets/vishesh-timeline.js only computes which milestone is current
  from scroll progress and toggles a class - it does not move, size, or
  position anything.
{% endcomment %}
<script src="{{ 'vishesh-timeline.js' | asset_url }}" defer="defer"></script>
<div class="vishesh-timeline color-{{ section.settings.color_scheme }} gradient" data-timeline>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h1 vishesh-timeline__heading" data-animate="fade-up">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <div
    class="vishesh-timeline__scroll"
    data-timeline-scroll
    style="--milestone-count: {{ section.blocks.size }};"
  >
    <div class="vishesh-timeline__stage">
      <div class="vishesh-timeline__inner">
        <ol class="vishesh-timeline__rail" role="list">
          {%- for block in section.blocks -%}
            <li class="vishesh-timeline__step" data-timeline-step="{{ forloop.index0 }}">
              <span class="vishesh-timeline__dot" aria-hidden="true"></span>
              <span class="vishesh-timeline__step-year">{{ block.settings.year }}</span>
            </li>
          {%- endfor -%}
        </ol>

        <ol class="vishesh-timeline__cards" role="list">
          {%- for block in section.blocks -%}
            {%- assign step_pct = forloop.index | times: 100.0 | divided_by: forloop.length -%}
            <li
              class="vishesh-timeline__card"
              data-timeline-card="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {% comment %}
                Oversized year set behind the copy. The card fills the full
                sticky stage now, and a few lines of text centred in that
                much white read as empty on their own - this anchors the
                lower half and ties the step to its era without needing a
                per-milestone image to download.
              {% endcomment %}
              <span class="vishesh-timeline__watermark" aria-hidden="true">{{ block.settings.year }}</span>

              <div class="vishesh-timeline__meta">
                <span class="vishesh-timeline__pin" aria-hidden="true">
                  <span class="vishesh-timeline__year">{{ block.settings.year }}</span>
                </span>
                <span class="vishesh-timeline__count" aria-hidden="true">
                  <span class="vishesh-timeline__count-now">{{ forloop.index }}</span
                  ><span class="vishesh-timeline__count-total">/{{ forloop.length }}</span>
                  <span class="vishesh-timeline__count-bar">
                    <span class="vishesh-timeline__count-fill" style="width: {{ step_pct }}%;"></span>
                  </span>
                </span>
              </div>

              <p class="vishesh-timeline__text">{{ block.settings.text }}</p>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vishesh Timeline",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vishesh Timeline",
      "blocks": [
        {
          "type": "milestone",
          "settings": { "year": "1970", "text": "Humble start with a small rented production unit at Udhna, Surat." }
        },
        {
          "type": "milestone",
          "settings": { "year": "1971", "text": "Extended our production unit, manufacturing only Hing for five years." }
        },
        {
          "type": "milestone",
          "settings": { "year": "1990", "text": "Received our first Agmark certification for Hing." }
        },
        {
          "type": "milestone",
          "settings": { "year": "1991", "text": "First mover in the market with Rajwadi Garam Masala and other spices." }
        },
        {
          "type": "milestone",
          "settings": { "year": "2009", "text": "The family parted ways and introduced Vishesh Masala to the market." }
        },
        {
          "type": "milestone",
          "settings": { "year": "2022", "text": "Installed our state-of-the-art production facility at Navsari, Gujarat." }
        }
      ]
    }
  ]
}
{% endschema %}
