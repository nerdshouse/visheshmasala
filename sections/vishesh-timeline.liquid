{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

{% comment %}
  Stacked-panel journey. Each milestone is a full-height panel that
  holds in place while the next one slides up over it, so the years
  advance one screen at a time as you scroll.

  The hold is plain CSS `position: sticky`, NOT a scripted pin. That
  distinction matters on this theme: GSAP ScrollTrigger pins have
  broken here repeatedly (this very section shipped with 5 of 9
  milestones permanently invisible, and purity-promise carried a
  5121px pin-spacer). Sticky is handled natively by the browser, adds
  no spacer element, never takes scroll away from the user, and needs
  no JS at all - so it cannot reproduce that failure mode.

  Layout per panel follows the two-column split from the reference:
  a marker column with the year, and a wider column with the copy,
  stacking to a single column on narrow screens. Visual treatment is
  the brand's own (map-pin marker, cream card), not the reference's.

  The previous grid + measured SVG connector
  (assets/vishesh-timeline-path.js) is gone: its geometry was computed
  from card positions in a 3/2/1 column grid, which no longer exists.
{% endcomment %}
<div class="vishesh-timeline color-{{ section.settings.color_scheme }} gradient" data-timeline>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="h1 vishesh-timeline__heading" data-animate="fade-up">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  <ol class="vishesh-timeline__track" role="list">
    {%- for block in section.blocks -%}
      <li class="vishesh-timeline__panel" {{ block.shopify_attributes }}>
        <div class="vishesh-timeline__panel-inner">
          <div class="vishesh-timeline__marker">
            <span class="vishesh-timeline__pin" aria-hidden="true">
              <span class="vishesh-timeline__year">{{ block.settings.year }}</span>
            </span>
            <span class="vishesh-timeline__count">
              {{ forloop.index }}<span class="vishesh-timeline__count-total">/{{ forloop.length }}</span>
            </span>
          </div>
          <div class="vishesh-timeline__body">
            <span class="vishesh-timeline__body-year" aria-hidden="true">{{ block.settings.year }}</span>
            <p class="vishesh-timeline__text">{{ block.settings.text }}</p>
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ol>
</div>

{% schema %}
{
  "name": "Vishesh Timeline",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vishesh Timeline",
      "blocks": [
        {
          "type": "milestone",
          "settings": { "year": "1970", "text": "Humble start with a small rented production unit at Udhna, Surat." }
        },
        {
          "type": "milestone",
          "settings": { "year": "1971", "text": "Extended our production unit, manufacturing only Hing for five years." }
        },
        {
          "type": "milestone",
          "settings": { "year": "1990", "text": "Received our first Agmark certification for Hing." }
        },
        {
          "type": "milestone",
          "settings": { "year": "1991", "text": "First mover in the market with Rajwadi Garam Masala and other spices." }
        },
        {
          "type": "milestone",
          "settings": { "year": "2009", "text": "The family parted ways and introduced Vishesh Masala to the market." }
        },
        {
          "type": "milestone",
          "settings": { "year": "2022", "text": "Installed our state-of-the-art production facility at Navsari, Gujarat." }
        }
      ]
    }
  ]
}
{% endschema %}
