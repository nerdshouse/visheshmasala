{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

<div class="vishesh-newsletter color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width vishesh-newsletter__inner" data-animate="fade-up">
    <div class="vishesh-newsletter__copy">
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    <div class="vishesh-newsletter__actions">
      {%- form 'customer', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <label class="field__label" for="NewsletterForm--{{ section.id }}">
              {{ 'newsletter.label' | t }}
            </label>
            <button
              type="submit"
              class="newsletter-form__button field__button"
              name="commit"
              aria-label="{{ 'newsletter.button_label' | t }}"
            >
              {{ 'icon-arrow.svg' | inline_asset_content }}
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
              {{ 'icon-error.svg' | inline_asset_content }}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>
        {%- if form.posted_successfully? -%}
          <h3 class="newsletter-form__message newsletter-form__message--success form__message" tabindex="-1" autofocus>
            {{ 'icon-success.svg' | inline_asset_content }}
            {{- 'newsletter.success' | t }}
          </h3>
        {%- endif -%}
      {%- endform -%}
      {%- if settings.whatsapp_number != blank and section.settings.whatsapp_label != blank -%}
        {%- assign wa_number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' -%}
        <a class="button button--secondary vishesh-newsletter__wa" href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener">
          {{ section.settings.whatsapp_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter + WhatsApp",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recipes & new masalas, straight to your inbox"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Or say hello on WhatsApp - we reply like family."
    },
    {
      "type": "text",
      "id": "whatsapp_label",
      "label": "WhatsApp button label",
      "default": "Chat on WhatsApp",
      "info": "Uses the WhatsApp number from Theme settings → Vishesh Masala. Hidden until that is set."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-4"
    }
  ],
  "presets": [{ "name": "Newsletter + WhatsApp" }]
}
{% endschema %}
