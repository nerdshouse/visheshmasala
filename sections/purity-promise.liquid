{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

{% comment %}
  Phase 8 rebuild: this section pinned-and-scrubbed through three
  rounds of overflow and permanent-scroll-lock bugs at short viewport
  heights (the pin/Lenis/ScrollTrigger interaction was never made
  reliably robust across viewport sizes). Rebuilt with no pin at all,
  and no section-specific JS either - just the theme's existing
  data-animate="fade-up" / data-animate-group reveal (assets/
  vishesh-motion.js), which every other section already uses. Simple
  and correct beats clever and broken. Visual treatment upgraded from
  a bordered-circle icon row to a proper card grid for a more premium,
  intentional feel.
{% endcomment %}
<div class="vishesh-purity color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width vishesh-purity__inner">
    <div class="vishesh-purity__badge-wrap" data-animate="fade-up">
      {% render 'vishesh-badge', class: 'vishesh-purity__badge', id: 'purity' %}
    </div>
    <h2 class="vishesh-purity__heading h1" data-animate="fade-up">{{ section.settings.heading }}</h2>
    {%- if section.settings.script_line != blank -%}
      <p class="vishesh-purity__script vishesh-script" data-animate="fade-up">{{ section.settings.script_line }}</p>
    {%- endif -%}
    <ul class="vishesh-purity__grid" role="list" data-animate-group>
      {%- for block in section.blocks -%}
        <li class="vishesh-purity__card" {{ block.shopify_attributes }}>
          <span class="vishesh-purity__icon">
            {%- case block.settings.icon -%}
              {%- when 'leaf' -%}
                {{ 'icon-leaf.svg' | inline_asset_content }}
              {%- when 'plant' -%}
                {{ 'icon-plant.svg' | inline_asset_content }}
              {%- when 'fire' -%}
                {{ 'icon-fire.svg' | inline_asset_content }}
              {%- when 'box' -%}
                {{ 'icon-box.svg' | inline_asset_content }}
              {%- when 'heart' -%}
                {{ 'icon-heart.svg' | inline_asset_content }}
              {%- else -%}
                {{ 'icon-check-mark.svg' | inline_asset_content }}
            {%- endcase -%}
          </span>
          <span class="vishesh-purity__label">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Purity Promise",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Vishesh?"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script subline",
      "default": "Quality is The GOD"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Checkmark" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "plant", "label": "Plant" },
            { "value": "fire", "label": "Fire" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purity Promise",
      "blocks": [
        { "type": "promise", "settings": { "label": "No Preservatives", "icon": "check" } },
        { "type": "promise", "settings": { "label": "Authentic Flavour", "icon": "fire" } },
        { "type": "promise", "settings": { "label": "Family Trusted for Generations", "icon": "heart" } },
        { "type": "promise", "settings": { "label": "Hygienically Packed", "icon": "leaf" } },
        { "type": "promise", "settings": { "label": "50+ Years of Trust", "icon": "box" } }
      ]
    }
  ]
}
{% endschema %}
