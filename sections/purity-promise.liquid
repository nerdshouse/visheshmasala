{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

{% comment %}
  Phase 8 rebuilt this section to drop a pin that broke three rounds of
  testing (see git history) - that call stands, this is not a return
  to pinning. What changed here (Phase 15) is the visual: the row-of-
  circles layout Phase 8 shipped replaced a badge-in-the-centre,
  promises-orbiting-around-it composition that was live before it, and
  that orbit look is what was actually wanted back. Rebuilt as pure
  CSS - each promise gets an evenly-spaced angle around the centre via
  the standard rotate / translate-outward / counter-rotate technique
  (values below), no JS positioning, so it isn't tied to exactly 4
  items the way the original corner-placed version was - it holds for
  however many blocks are configured (schema allows up to 7).
  Reveal is the sitewide data-animate-group stagger, same as every
  other section - no bespoke scroll-linked JS.
{% endcomment %}
<div class="vishesh-purity color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width vishesh-purity__inner">
    <h2 class="vishesh-purity__heading h1" data-animate="fade-up">{{ section.settings.heading }}</h2>
    {%- if section.settings.script_line != blank -%}
      <p class="vishesh-purity__script vishesh-script" data-animate="fade-up">{{ section.settings.script_line }}</p>
    {%- endif -%}
    <div class="vishesh-purity__cluster" data-animate="fade-up">
      <span class="vishesh-sparkle vishesh-sparkle--1" aria-hidden="true">&#10022;</span>
      <span class="vishesh-sparkle vishesh-sparkle--2" aria-hidden="true">&#10022;</span>
      <div class="vishesh-purity__ring" aria-hidden="true"></div>
      <div class="vishesh-purity__badge-wrap">
        {% render 'vishesh-badge', class: 'vishesh-purity__badge', id: 'purity' %}
      </div>
      {%- comment -%}
        Each promise is two nested elements on purpose. The <li> owns
        the orbit placement (a CSS `transform` built from --angle), and
        the inner <span> owns the entrance animation. They have to stay
        separate because the reveal tweens `y`/`scale`, which GSAP
        writes as an inline `transform` - on the <li> that would
        overwrite the placement transform and snap every pill to the
        centre of the circle. data-animate-group-item points the
        sitewide group reveal at the inner spans instead, so the two
        transforms never touch each other.
      {%- endcomment -%}
      <ul class="vishesh-purity__orbit" role="list" data-animate-group>
        {%- assign promise_count = section.blocks.size -%}
        {%- for block in section.blocks -%}
          {%- assign angle = 360.0 | times: forloop.index0 | divided_by: promise_count -%}
          <li
            class="vishesh-purity__sticker"
            style="--angle: {{ angle }}deg;"
            {{ block.shopify_attributes }}
          >
            <span class="vishesh-purity__sticker-inner" data-animate-group-item>
              <span class="vishesh-purity__sticker-icon">
                {%- case block.settings.icon -%}
                  {%- when 'leaf' -%}
                    {{ 'icon-leaf.svg' | inline_asset_content }}
                  {%- when 'plant' -%}
                    {{ 'icon-plant.svg' | inline_asset_content }}
                  {%- when 'fire' -%}
                    {{ 'icon-fire.svg' | inline_asset_content }}
                  {%- when 'box' -%}
                    {{ 'icon-box.svg' | inline_asset_content }}
                  {%- when 'heart' -%}
                    {{ 'icon-heart.svg' | inline_asset_content }}
                  {%- else -%}
                    {{ 'icon-check-mark.svg' | inline_asset_content }}
                {%- endcase -%}
              </span>
              <span class="vishesh-purity__sticker-label">{{ block.settings.label }}</span>
            </span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purity Promise",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Vishesh?"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script subline",
      "default": "Quality is The GOD"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Checkmark" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "plant", "label": "Plant" },
            { "value": "fire", "label": "Fire" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purity Promise",
      "blocks": [
        { "type": "promise", "settings": { "label": "No Preservatives", "icon": "check" } },
        { "type": "promise", "settings": { "label": "Authentic Flavour", "icon": "fire" } },
        { "type": "promise", "settings": { "label": "Family Trusted for Generations", "icon": "heart" } },
        { "type": "promise", "settings": { "label": "Hygienically Packed", "icon": "leaf" } },
        { "type": "promise", "settings": { "label": "50+ Years of Trust", "icon": "box" } }
      ]
    }
  ]
}
{% endschema %}
