{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purity-promise.js' | asset_url }}" defer="defer"></script>

{% comment %}
  Editorial rework (Phase 3/6): the previous dashed-orbit-ring +
  absolute-positioned sticker cluster was tuned for one viewport and
  overflowed at others (the whole reason absolute-positioned decorative
  elements are risky). This version uses normal document flow only -
  a centered heading, then a wrapping row of icon items - so it cannot
  overflow at any width by construction. The pinned-scroll reveal
  mechanic is kept (assets/purity-promise.js), just driving opacity/
  transform on in-flow elements instead of scattered absolute ones.
{% endcomment %}
<div class="vishesh-purity color-{{ section.settings.color_scheme }} gradient">
  <div class="purity-pin">
    <div class="page-width vishesh-purity__inner">
      <div class="vishesh-purity__badge-wrap">
        {% render 'vishesh-badge', class: 'vishesh-purity__badge', id: 'purity' %}
      </div>
      <h2 class="vishesh-purity__heading h1">
        {%- assign heading_words = section.settings.heading | split: ' ' -%}
        {%- for word in heading_words -%}
          <span class="vishesh-purity__word">{{ word }}</span>
          {%- unless forloop.last %} {% endunless -%}
        {%- endfor -%}
      </h2>
      {%- if section.settings.script_line != blank -%}
        <p class="vishesh-purity__script vishesh-script">{{ section.settings.script_line }}</p>
      {%- endif -%}
      <ul class="vishesh-purity__row" role="list">
        {%- for block in section.blocks -%}
          <li class="vishesh-purity__item" {{ block.shopify_attributes }}>
            <span class="vishesh-purity__icon">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}
                  {{ 'icon-leaf.svg' | inline_asset_content }}
                {%- when 'plant' -%}
                  {{ 'icon-plant.svg' | inline_asset_content }}
                {%- when 'fire' -%}
                  {{ 'icon-fire.svg' | inline_asset_content }}
                {%- when 'box' -%}
                  {{ 'icon-box.svg' | inline_asset_content }}
                {%- when 'heart' -%}
                  {{ 'icon-heart.svg' | inline_asset_content }}
                {%- else -%}
                  {{ 'icon-check-mark.svg' | inline_asset_content }}
              {%- endcase -%}
            </span>
            <span class="vishesh-purity__label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Purity Promise",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Vishesh?"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script subline",
      "default": "Quality is The GOD"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "Checkmark" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "plant", "label": "Plant" },
            { "value": "fire", "label": "Fire" },
            { "value": "box", "label": "Box" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "check"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purity Promise",
      "blocks": [
        { "type": "promise", "settings": { "label": "No Preservatives", "icon": "check" } },
        { "type": "promise", "settings": { "label": "Authentic Flavour", "icon": "fire" } },
        { "type": "promise", "settings": { "label": "Family Trusted for Generations", "icon": "heart" } },
        { "type": "promise", "settings": { "label": "Hygienically Packed", "icon": "leaf" } },
        { "type": "promise", "settings": { "label": "50+ Years of Trust", "icon": "box" } }
      ]
    }
  ]
}
{% endschema %}
