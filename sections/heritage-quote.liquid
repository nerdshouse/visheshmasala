{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

<div class="vishesh-quote color-{{ section.settings.color_scheme }} gradient{% if section.settings.background_image != blank %} vishesh-quote--has-image{% endif %}">
  {%- if section.settings.background_image != blank -%}
    <div class="vishesh-quote__media" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 1600
        | image_tag: loading: 'lazy', class: 'vishesh-quote__image', widths: '750, 1100, 1600', sizes: '100vw'
      }}
      <div class="vishesh-quote__scrim"></div>
    </div>
  {%- endif -%}
  <div class="page-width vishesh-quote__inner" data-animate="fade-up">
    <span class="vishesh-quote__mark" aria-hidden="true">&ldquo;</span>
    <blockquote class="vishesh-quote__text">{{ section.settings.quote }}</blockquote>
    {%- if section.settings.attribution != blank -%}
      <cite class="vishesh-quote__attribution">{{ section.settings.attribution }}</cite>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Heritage Quote",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "For us, Quality is The GOD - and it is this no-compromise attitude towards quality that gives us the confidence to promise our consumers the Best, and serve them the Purest."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "The Wankawala Family"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background photo",
      "info": "Optional. A heritage/production/family photo works best - a dark scrim is applied automatically so the quote stays legible on top of it."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    }
  ],
  "presets": [{ "name": "Heritage Quote" }]
}
{% endschema %}
