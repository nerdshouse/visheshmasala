{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

{% comment %}
  Infrastructure. Was a plain rich-text block - an eyebrow, a heading
  and one long paragraph on a flat panel - which buried the concrete
  facts inside prose. Same facts, surfaced as stat tiles instead.

  Every figure here comes from the copy that was already on the page
  (footprint, location, 24x7 power and water, in-house R&D). Nothing
  is invented; the tiles are section blocks so the merchant can edit
  or add to them without a theme change.
{% endcomment %}
<div class="vishesh-infra color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width vishesh-infra__inner">
    <div class="vishesh-infra__intro">
      {%- if section.settings.eyebrow != blank -%}
        <span class="vishesh-infra__eyebrow" data-animate="fade-up">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="vishesh-infra__heading h1" data-animate="fade-up">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="vishesh-infra__text rte" data-animate="fade-up">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a
          href="{{ section.settings.button_link }}"
          class="button vishesh-infra__button"
          data-animate="fade-up"
          target="_blank"
          rel="noopener"
        >
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="vishesh-infra__stats" role="list" data-animate-group>
        {%- for block in section.blocks -%}
          <li class="vishesh-infra__stat" {{ block.shopify_attributes }}>
            <span class="vishesh-infra__stat-value">
              {{- block.settings.value -}}
              {%- if block.settings.unit != blank -%}
                <span class="vishesh-infra__stat-unit">{{ block.settings.unit }}</span>
              {%- endif -%}
            </span>
            <span class="vishesh-infra__stat-label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vishesh Infrastructure",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Navsari, Gujarat" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From a home-grown venture to state-of-the-art infrastructure"
    },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get Directions" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-5" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "value", "label": "Value" },
        { "type": "text", "id": "unit", "label": "Unit" },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vishesh Infrastructure",
      "blocks": [
        { "type": "stat", "settings": { "value": "1,15,155", "unit": "sq.ft.", "label": "Manufacturing facility" } },
        { "type": "stat", "settings": { "value": "24x7", "label": "Power and water supply" } },
        { "type": "stat", "settings": { "value": "In-house", "label": "R&D department" } }
      ]
    }
  ]
}
{% endschema %}
