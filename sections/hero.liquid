{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hero.js' | asset_url }}" defer="defer"></script>

<div class="vishesh-hero color-{{ section.settings.color_scheme }} gradient">
  <div class="vishesh-hero__inner page-width">
    <div class="vishesh-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vishesh-hero__eyebrow" data-animate="fade-up">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="vishesh-hero__headline" data-kinetic-headline>{{ section.settings.heading }}</h1>
      {%- if section.settings.script_line != blank -%}
        <p class="vishesh-hero__script vishesh-script" data-animate="fade-up">{{ section.settings.script_line }}</p>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="vishesh-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="vishesh-hero__ctas">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="button">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link | default: '#' }}" class="button button--secondary">
            {{ section.settings.cta2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
    {%- if section.settings.show_badge -%}
      <div class="vishesh-hero__badge" data-hero-badge aria-hidden="true">
        <svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <path id="vishesh-badge-circle" d="M 60,60 m -44,0 a 44,44 0 1,1 88,0 a 44,44 0 1,1 -88,0"/>
          </defs>
          <circle cx="60" cy="60" r="58" fill="var(--color-primary)"/>
          <circle cx="60" cy="60" r="30" fill="#ffffff"/>
          <text fill="#ffffff" font-size="13.5" font-weight="700" letter-spacing="2.5">
            <textPath href="#vishesh-badge-circle">TRUST OF 50 YEARS · TRUST OF 50 YEARS ·</textPath>
          </text>
          <text x="60" y="57" text-anchor="middle" fill="var(--color-primary)" font-size="15" font-weight="800">50</text>
          <text x="60" y="72" text-anchor="middle" fill="var(--color-primary)" font-size="9" font-weight="700">YEARS</text>
        </svg>
      </div>
    {%- endif -%}
    <span class="vishesh-sparkle vishesh-sparkle--1" aria-hidden="true">&#10022;</span>
    <span class="vishesh-sparkle vishesh-sparkle--2" aria-hidden="true">&#10022;</span>
    <span class="vishesh-sparkle vishesh-sparkle--3" aria-hidden="true">&#10022;</span>
    <div class="vishesh-hero__media">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag: loading: 'eager', fetchpriority: 'high', class: 'vishesh-hero__image', widths: '400, 600, 800, 1000, 1400'
        }}
      {%- else -%}
        <div class="vishesh-hero__spices" aria-hidden="true">
          <span class="vishesh-hero__spice vishesh-hero__spice--terracotta" data-hero-float></span>
          <span class="vishesh-hero__spice vishesh-hero__spice--saffron" data-hero-float></span>
          <span class="vishesh-hero__spice vishesh-hero__spice--sage" data-hero-float></span>
          <span class="vishesh-hero__spice vishesh-hero__spice--maroon" data-hero-float></span>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vishesh Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Trust of 50 Years · Since 1970"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Spices of Bharat"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script tagline",
      "default": "Kitchen Se Dil Tak",
      "info": "Rendered in the brand brush-script font."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Blended by the Wankawala family since 1970 - trusted in kitchens across India for 50+ years."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary button label",
      "default": "Shop Masalas"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Secondary button label",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (optional)",
      "info": "When empty, animated spice shapes are shown instead."
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show spinning \"Trust of 50 Years\" badge",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Vishesh Hero" }]
}
{% endschema %}
