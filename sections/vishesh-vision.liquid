{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

{% comment %}
  Vision / Brand Promise. Replaces a generic Dawn multicolumn, which
  rendered these as two bare centred text blocks on a flat orange
  panel with nothing to anchor them. Purpose-built here so each
  statement reads as a deliberate brand statement: an eyebrow, a
  numbered marker, the heading, and a rule under it.

  Copy comes from section blocks and is unchanged from the previous
  section - this is a presentation change, not a rewrite.
{% endcomment %}
<div class="vishesh-vision color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="vishesh-vision__heading h1" data-animate="fade-up">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="vishesh-vision__grid" data-animate-group>
      {%- for block in section.blocks -%}
        <article class="vishesh-vision__card" {{ block.shopify_attributes }}>
          <span class="vishesh-vision__index" aria-hidden="true">
            {{ forloop.index | prepend: '0' | slice: -2, 2 }}
          </span>
          {%- if block.settings.eyebrow != blank -%}
            <span class="vishesh-vision__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          <h3 class="vishesh-vision__title">{{ block.settings.title }}</h3>
          <div class="vishesh-vision__text rte">{{ block.settings.text }}</div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Vishesh Vision",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Drives Us"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "statement",
      "name": "Statement",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vishesh Vision",
      "blocks": [
        { "type": "statement", "settings": { "eyebrow": "Where we are going" } },
        { "type": "statement", "settings": { "eyebrow": "What we stand for" } }
      ]
    }
  ]
}
{% endschema %}
