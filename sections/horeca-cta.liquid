{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}

<div class="vishesh-horeca color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width vishesh-horeca__inner" data-animate="fade-up">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="vishesh-horeca__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h1">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      <a href="{{ section.settings.cta_link | default: '/pages/contact' }}" class="button">
        {{ section.settings.cta_label }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HORECA CTA",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Hotels · Restaurants · Caterers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Vishesh for your kitchen, at scale"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bulk packs and consistent blends for professional kitchens across retail, wholesale and HORECA."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Request a Quote"
    },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    }
  ],
  "presets": [{ "name": "HORECA CTA" }]
}
{% endschema %}
