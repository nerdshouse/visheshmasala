{{ 'vm-discovery.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Home page combo cards. Contents, prices and the "if bought separately"
  figure all come from snippets/vm-combos.liquid. Scrolls sideways on
  phones (CSS scroll-snap, no carousel script), three across on desktop.
  id="combos" so a menu item can link to /#combos.
{%- endcomment -%}
<section
  id="combos"
  class="vm-combos color-{{ section.settings.color_scheme }} gradient"
  aria-labelledby="VmCombosHeading-{{ section.id }}"
>
  <div class="page-width">
    <div class="vm-combos__header" data-animate="fade-up">
      {%- if section.settings.eyebrow != blank -%}
        <p class="vm-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 id="VmCombosHeading-{{ section.id }}" class="h1 vm-combos__heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.script_line != blank -%}
        <p class="vishesh-script vm-combos__script">{{ section.settings.script_line | escape }}</p>
      {%- endif -%}
    </div>
    <ul class="vm-combos__track" role="list">
      {%- render 'vm-combos', mode: 'cards', min_saving_pct: section.settings.min_saving_pct -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Combos",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Combos"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everyday masalas, packed together"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script line"
    },
    {
      "type": "range",
      "id": "min_saving_pct",
      "label": "Show the saving badge from",
      "min": 1,
      "max": 20,
      "step": 1,
      "unit": "%",
      "default": 5,
      "info": "The badge appears only when the combo costs at least this much less than its packs bought separately. The separate total is always shown."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Combos"
    }
  ]
}
{% endschema %}
