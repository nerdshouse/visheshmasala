{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'vishesh-carousel.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- assign collection = section.settings.collection -%}

<div class="vishesh-carousel color-{{ section.settings.color_scheme }} gradient" data-carousel>
  <div class="page-width">
    <div class="vishesh-carousel__header" data-animate="fade-up">
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <div class="vishesh-carousel__nav">
        <button class="vishesh-swiper-prev vishesh-carousel__arrow" aria-label="{{ 'general.slider.previous_slide' | t }}">
          {{ 'icon-caret.svg' | inline_asset_content }}
        </button>
        <button class="vishesh-swiper-next vishesh-carousel__arrow" aria-label="{{ 'general.slider.next_slide' | t }}">
          {{ 'icon-caret.svg' | inline_asset_content }}
        </button>
      </div>
    </div>
  </div>
  <div class="vishesh-carousel__track page-width">
    <div class="swiper vishesh-swiper">
      <div class="swiper-wrapper">
        {%- if collection != blank and collection.products.size > 0 -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            <div class="swiper-slide vishesh-product-slide">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: 'square',
                show_secondary_image: true,
                show_quick_add: section.settings.show_quick_add,
                section_id: section.id
              %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            <div class="swiper-slide vishesh-product-slide">
              {% render 'card-product' %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- if section.settings.show_view_all and collection != blank -%}
    <div class="page-width vishesh-carousel__viewall" data-animate="fade-up">
      <a href="{{ collection.url }}" class="button button--secondary">
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Bestsellers Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Create a \"Bestsellers\" collection and pick it here."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view-all button",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Bestsellers Carousel" }]
}
{% endschema %}
