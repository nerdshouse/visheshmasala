{{ 'vishesh-sections.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'vishesh-bestsellers.js' | asset_url }}" defer="defer"></script>

{%- assign collection = section.settings.collection -%}
{%- assign slide_colors = 'var(--color-primary)|var(--color-sage)|var(--color-orange)' | split: '|' -%}
{%- assign top_seller_id = section.settings.top_seller.id -%}

<div class="vishesh-bestsellers color-{{ section.settings.color_scheme }} gradient" data-vishesh-bestsellers>
  <div class="page-width vishesh-bestsellers__header" data-animate="fade-up">
    <h2 class="h0 vishesh-bestsellers__heading">
      {{- section.settings.heading -}}
      <span class="vishesh-bestsellers__heading-star" aria-hidden="true">&#10022;</span>
    </h2>
    {%- if section.settings.script_line != blank -%}
      <p class="vishesh-script vishesh-bestsellers__script">{{ section.settings.script_line }}</p>
    {%- endif -%}
  </div>

  <div class="vishesh-bestsellers__stage">
    {% comment %}
      Soft tinted halo behind the centred card. The arch shape itself now
      lives on each card (see .vishesh-bestsellers__media) so that a card
      reads as one object top to bottom; this is only depth behind it.
    {% endcomment %}
    <div class="vishesh-bestsellers__glow" data-bestsellers-arch aria-hidden="true"></div>
    <div class="swiper vishesh-bestsellers__swiper" data-bestsellers-swiper>
      <div class="swiper-wrapper">
        {%- if collection != blank and collection.products.size > 0 -%}
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            {%- assign color_i = forloop.index0 | modulo: 3 -%}
            {%- assign color = slide_colors[color_i] -%}
            {%- assign is_top_seller = false -%}
            {%- if top_seller_id != blank and product.id == top_seller_id -%}
              {%- assign is_top_seller = true -%}
            {%- endif -%}
            <div
              class="swiper-slide vishesh-bestsellers__slide{% if is_top_seller %} vishesh-bestsellers__slide--top{% endif %}"
              data-color="{{ color }}"
              style="--slide-accent: {{ color }};"
            >
              <article class="vishesh-bestsellers__card">
                <div class="vishesh-bestsellers__media">
                  {%- if is_top_seller and section.settings.top_tag_label != blank -%}
                    {% comment %}
                      The only badge in the carousel. Phase 19 gave the rest
                      of the set a lighter "Bestseller" chip; Phase 20 drops
                      it, because a label repeated on eight of nine slides
                      reads as decoration and dilutes the one badge that is
                      actually meant to carry rank.
                    {% endcomment %}
                    <span class="vishesh-bestsellers__tag vishesh-bestsellers__tag--top">
                      <svg class="vishesh-bestsellers__tag-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                        <path d="M12 2.6l2.6 5.8 6.3.7-4.7 4.3 1.3 6.2L12 16.5 6.5 19.6l1.3-6.2L3.1 9.1l6.3-.7z"/>
                      </svg>
                      {{ section.settings.top_tag_label }}
                    </span>
                  {%- endif -%}
                  <a href="{{ product.url }}" class="vishesh-bestsellers__image-wrap">
                    {%- if product.featured_image -%}
                      {% comment %}
                        The card image renders at ~260px on phones and
                        ~320px on desktop. Without a `sizes` hint the
                        browser assumes 100vw and takes the widest
                        candidate it has - it was pulling the 900w file
                        for a 261px slot, measured live. On a slow
                        connection that is what makes the arch sit as a
                        blank block of colour for a beat before the pack
                        photo appears. Candidates are sized for the real
                        slot instead, with headroom for 2x screens.
                      {% endcomment %}
                      {{
                        product.featured_image
                        | image_url: width: 640
                        | image_tag:
                          loading: 'lazy',
                          class: 'vishesh-bestsellers__image',
                          widths: '260, 400, 520, 640',
                          sizes: '(min-width: 990px) 320px, 260px',
                          alt: product.title
                      }}
                    {%- endif -%}
                  </a>
                </div>
                <div class="vishesh-bestsellers__content">
                  <a href="{{ product.url }}" class="vishesh-bestsellers__title h2">{{ product.title }}</a>
                  {%- assign vishesh_pack_variants = false -%}
                  {%- if product.options_by_name['Pack Size'] -%}
                    {%- assign vishesh_pack_variants = true -%}
                  {%- endif -%}
                  {%- render 'price', product: product, price_class: '', use_variant: vishesh_pack_variants -%}
                  {%- if vishesh_pack_variants -%}
                    {%- render 'vishesh-pack-selector', card_product: product, section_id: section.id -%}
                  {%- else -%}
                    <a href="{{ product.url }}" class="vishesh-bestsellers__cta">
                      <span>{{ 'products.product.add_to_cart' | t }} | {{ product.price | money }}</span>
                    </a>
                  {%- endif -%}
                </div>
              </article>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
    <button class="vishesh-carousel__arrow vishesh-bestsellers__arrow vishesh-bestsellers__arrow--prev" data-bestsellers-prev aria-label="{{ 'general.slider.previous_slide' | t }}">
      {{ 'icon-caret.svg' | inline_asset_content }}
    </button>
    <button class="vishesh-carousel__arrow vishesh-bestsellers__arrow vishesh-bestsellers__arrow--next" data-bestsellers-next aria-label="{{ 'general.slider.next_slide' | t }}">
      {{ 'icon-caret.svg' | inline_asset_content }}
    </button>
  </div>

  {% comment %}
    Trust marks sit here, immediately under the cards and next to the
    purchase decision, rather than only in the footer. Both are facts the
    theme already states elsewhere (trust-strip section, PDP accordion) -
    no counts, ratings or sales numbers, which would need real merchant
    data before they could be claimed.
  {% endcomment %}
  {%- if section.settings.show_trust -%}
    {%- if section.settings.trust_one != blank or section.settings.trust_two != blank -%}
      <ul class="vishesh-bestsellers__trust page-width" data-animate="fade-up" role="list">
        {%- if section.settings.trust_one != blank -%}
          <li class="vishesh-bestsellers__trust-item">
            <svg class="vishesh-bestsellers__trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M12 2.8l7.2 2.6v6c0 4.4-3 8.2-7.2 9.8-4.2-1.6-7.2-5.4-7.2-9.8v-6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
              <path d="M8.7 11.9l2.3 2.3 4.3-4.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ section.settings.trust_one }}
          </li>
        {%- endif -%}
        {%- if section.settings.trust_two != blank -%}
          <li class="vishesh-bestsellers__trust-item">
            <svg class="vishesh-bestsellers__trust-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <rect x="3.6" y="3.6" width="16.8" height="16.8" rx="2.4" stroke="currentColor" stroke-width="1.7"/>
              <circle cx="12" cy="12" r="4" fill="currentColor"/>
            </svg>
            {{ section.settings.trust_two }}
          </li>
        {%- endif -%}
      </ul>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.show_view_all and collection != blank -%}
    <div class="page-width vishesh-carousel__viewall" data-animate="fade-up">
      <a href="{{ collection.url }}" class="button button--secondary">
        {{ 'sections.featured_collection.view_all' | t }}
      </a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Bestsellers Carousel",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "script_line",
      "label": "Script subline",
      "default": "Har ghar ka favourite"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Badges"
    },
    {
      "type": "product",
      "id": "top_seller",
      "label": "#1 bestseller",
      "info": "Gets the gold rank badge. Every other product in the set gets the lighter chip below. Leave empty to give all products the lighter chip. Must also be in the collection above."
    },
    {
      "type": "text",
      "id": "top_tag_label",
      "label": "Rank badge label",
      "default": "#1 Bestseller"
    },
    {
      "type": "header",
      "content": "Trust marks"
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust marks under the carousel",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_one",
      "label": "Trust mark 1",
      "default": "FSSAI Certified"
    },
    {
      "type": "text",
      "id": "trust_two",
      "label": "Trust mark 2",
      "default": "100% Vegetarian · Jain-friendly"
    },
    {
      "type": "header",
      "content": "Footer"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view-all button",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Bestsellers Carousel" }]
}
{% endschema %}
