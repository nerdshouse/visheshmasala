{{ 'vm-discovery.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Registrations - laid out like the back panel of a pack: the name, the
  number, one plain line on what it is. Business registrations, not
  product certifications, and the footnote says so.

  "Pending item" blocks (used for the US FDA facility registration) are
  visible only in the theme editor, never to customers, and have no field
  for a number - nothing can be published from them by accident.
{%- endcomment -%}
{%- liquid
  assign vm_public = 0
  for block in section.blocks
    if block.type == 'registration' and block.settings.number != blank
      assign vm_public = vm_public | plus: 1
    endif
  endfor
-%}
{%- if vm_public > 0 or request.design_mode -%}
  <div class="vm-credentials color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width vm-credentials__inner" data-animate="fade-up">
      <div class="vm-credentials__head">
        {%- if section.settings.heading != blank -%}
          <h2 class="h3 vm-credentials__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="vm-credentials__intro">{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
      <dl class="vm-credentials__list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'registration' -%}
              {%- if block.settings.number != blank -%}
                <div class="vm-credential" {{ block.shopify_attributes }}>
                  <dt class="vm-credential__name">{{ block.settings.title | escape }}</dt>
                  <dd class="vm-credential__number">{{ block.settings.number | escape }}</dd>
                  {%- if block.settings.note != blank -%}
                    <dd class="vm-credential__note">{{ block.settings.note | escape }}</dd>
                  {%- endif -%}
                  {%- if block.settings.validity != blank -%}
                    <dd class="vm-credential__validity">{{ block.settings.validity | escape }}</dd>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- when 'pending' -%}
              {%- if request.design_mode -%}
                <div class="vm-credential vm-credential--pending" {{ block.shopify_attributes }}>
                  <dt class="vm-credential__name">{{ block.settings.title | escape }}</dt>
                  <dd class="vm-credential__note">
                    Not shown to customers. {{ block.settings.note | escape }}
                  </dd>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </dl>
      {%- if section.settings.footnote != blank -%}
        <p class="vm-credentials__footnote">{{ section.settings.footnote | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Registrations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Licensed and registered"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Intro"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote",
      "default": "These are registrations of our business, not certifications of individual products."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "registration",
      "name": "Registration",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "info": "Use the exact name on the certificate, e.g. FSSAI Central Licence."
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "info": "The block is hidden while this is empty."
        },
        {
          "type": "text",
          "id": "note",
          "label": "What it is",
          "info": "One plain line. Don't imply product approval or certification."
        },
        {
          "type": "text",
          "id": "validity",
          "label": "Validity",
          "info": "Optional, e.g. Valid until 31 March 2027 - only as printed on the certificate."
        }
      ]
    },
    {
      "type": "pending",
      "name": "Pending item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note"
        },
        {
          "type": "paragraph",
          "content": "Visible only in the theme editor. Has no number field on purpose - add a Registration block once publication is approved."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Registrations"
    }
  ]
}
{% endschema %}
