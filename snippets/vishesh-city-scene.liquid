            <g transform="translate(350,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--4" d="M0 0 L9 -3 L12 5 L4 10 L-4 6 Z" fill="var(--color-terracotta)"/>
            </g>
            <g transform="translate(430,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--5" d="M0 0 L7 -4 L11 3 L5 9 L-3 5 Z" fill="var(--color-primary)"/>
            </g>
            <g transform="translate(510,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--6" d="M0 0 L8 -2 L10 6 L3 9 L-4 4 Z" fill="var(--color-terracotta)"/>
            </g>
            <g transform="translate(590,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--7" d="M0 0 L9 -3 L12 5 L4 10 L-4 6 Z" fill="var(--color-accent)"/>
            </g>
            <g transform="translate(670,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--8" d="M0 0 L7 -4 L11 3 L5 9 L-3 5 Z" fill="var(--color-primary)"/>
            </g>
          </svg>
        {%- when 'gujarat' -%}
          {%- comment -%}
            Stepwell (vav) corridor, flat-design receding arches, with a
            bandhani (tie-dye) dot border along the top edge - the dots
            reuse the existing vishesh-twinkle keyframe (already gated for
            reduced motion) rather than a new one.
          {%- endcomment -%}
          <svg
            class="vishesh-city-scene__svg"
            viewBox="0 0 800 220"
            preserveAspectRatio="xMidYMax slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="vg-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--color-cream)"/>
                <stop offset="1" stop-color="#fdf6e8"/>
