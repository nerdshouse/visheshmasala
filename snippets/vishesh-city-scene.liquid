              <circle cx="200" cy="30" r="5" fill="var(--color-accent)"/>
              <circle cx="280" cy="30" r="5" fill="var(--color-terracotta)"/>
              <circle cx="360" cy="30" r="5" fill="var(--color-accent)"/>
              <circle cx="440" cy="30" r="5" fill="var(--color-terracotta)"/>
