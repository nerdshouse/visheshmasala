{% comment %}
  Playful, illustrated product-page strip driven by the "custom.city_theme"
  metafield (single line text). Two kinds of entries share this registry:
  city scenes ("mumbai", "delhi") - an associative styling device (this
  dish is often eaten in X city), not a factual origin claim - and
  product-specific effects ("chilli-flakes") for a product whose visual
  treatment doesn't fit the city-scene idea at all. Renders nothing when
  unset or unrecognised - no forced placeholder.

  Registry pattern: to add another entry, drop in one more {%- when -%}
  block below with its own inline SVG and a matching CSS block in
  vishesh-sections.css (.vishesh-city-scene--<key> ...). Flat-design
  vector line art, brand palette only, no photography, no trademarked
  monument renders - the Delhi arch below is a generic gateway silhouette,
  not a specific landmark.

  The suggested product -> city mapping (Pavbhaji/Frankie -> Mumbai, a
  Punjabi-style masala -> Delhi, etc.) is a starting guess flagged for the
  brand to confirm before launch, same as other placeholder facts in this
  project - see CLAUDE.md.

  Accepts: product (required)
{% endcomment %}

{%- assign city = product.metafields.custom.city_theme.value | default: '' | downcase | strip -%}

{%- if city == 'mumbai' or city == 'delhi' or city == 'chilli-flakes' -%}
  <div class="vishesh-city-scene vishesh-city-scene--{{ city }}" data-animate="fade-up">
    <div class="page-width vishesh-city-scene__header">
      <p class="vishesh-city-scene__caption">
        {%- if city == 'mumbai' -%}
          A taste that feels like Mumbai's streets
        {%- elsif city == 'delhi' -%}
          A taste that feels like Delhi's galis
        {%- else -%}
          A pinch of heat in every batch
        {%- endif -%}
      </p>
    </div>
    <div class="vishesh-city-scene__stage" aria-hidden="true">
      {%- case city -%}
        {%- when 'mumbai' -%}
          <svg
            class="vishesh-city-scene__svg"
            viewBox="0 0 800 220"
            preserveAspectRatio="xMidYMax slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="vm-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--color-cream)"/>
                <stop offset="1" stop-color="#fff9ee"/>
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="800" height="220" fill="url(#vm-sky)"/>

            <!-- Skyline, back layer (lightest, furthest) -->
            <g fill="var(--color-dark)" opacity="0.18">
              <rect x="0" y="86" width="34" height="94" rx="2"/>
              <rect x="40" y="102" width="26" height="78" rx="2"/>
              <rect x="120" y="94" width="30" height="86" rx="2"/>
              <rect x="600" y="90" width="30" height="90" rx="2"/>
              <rect x="700" y="100" width="26" height="80" rx="2"/>
              <rect x="748" y="82" width="34" height="98" rx="2"/>
            </g>

            <!-- Skyline, mid layer -->
            <g fill="var(--color-dark)" opacity="0.32">
              <rect x="66" y="70" width="30" height="110" rx="2"/>
              <path d="M96 70 h30 v-14 l-15 -12 -15 12 Z" opacity="0.9"/>
              <rect x="150" y="60" width="26" height="120" rx="2"/>
              <rect x="660" y="66" width="32" height="114" rx="2"/>
              <rect x="630" y="46" width="24" height="134" rx="2"/>
              <path d="M630 46 h24 v-12 l-12 -10 -12 10 Z"/>
            </g>

            <!-- Skyline, front layer (darkest, nearest) -->
            <g fill="var(--color-dark)" opacity="0.55">
              <rect x="10" y="118" width="40" height="62" rx="3"/>
              <rect x="176" y="96" width="34" height="84" rx="3"/>
              <path d="M176 96 h34 v-16 l-17 -13 -17 13 Z"/>
              <rect x="580" y="112" width="36" height="68" rx="3"/>
              <rect x="726" y="104" width="34" height="76" rx="3"/>
            </g>
            <!-- windows -->
            <g fill="var(--color-cream)" opacity="0.85">
              <rect x="18" y="128" width="5" height="7"/>
              <rect x="30" y="128" width="5" height="7"/>
              <rect x="18" y="142" width="5" height="7"/>
              <rect x="30" y="142" width="5" height="7"/>
              <rect x="18" y="156" width="5" height="7"/>
              <rect x="30" y="156" width="5" height="7"/>
              <rect x="184" y="108" width="5" height="7"/>
              <rect x="196" y="108" width="5" height="7"/>
              <rect x="184" y="122" width="5" height="7"/>
              <rect x="196" y="122" width="5" height="7"/>
              <rect x="588" y="122" width="5" height="7"/>
              <rect x="600" y="122" width="5" height="7"/>
              <rect x="588" y="136" width="5" height="7"/>
              <rect x="600" y="136" width="5" height="7"/>
              <rect x="734" y="114" width="5" height="7"/>
              <rect x="746" y="114" width="5" height="7"/>
            </g>

            <!-- ground -->
            <rect x="0" y="178" width="800" height="2" fill="var(--color-dark)" opacity="0.25"/>

            <!-- rail track for the local train -->
            <line x1="0" y1="168" x2="800" y2="168" stroke="var(--color-dark)" stroke-width="1.5" opacity="0.3"/>
            <g class="vishesh-city-scene__sleepers" opacity="0.3" stroke="var(--color-dark)" stroke-width="1.5">
              <line x1="20" y1="166" x2="20" y2="171"/>
              <line x1="60" y1="166" x2="60" y2="171"/>
              <line x1="100" y1="166" x2="100" y2="171"/>
              <line x1="140" y1="166" x2="140" y2="171"/>
              <line x1="180" y1="166" x2="180" y2="171"/>
            </g>

            <!-- local train, flat-design: rounded body, arched windows, coupled cars -->
            <g class="vishesh-city-scene__train" transform="translate(-220,120)">
              <path
                d="M0 28 Q0 8 16 8 H206 Q222 8 222 28 V44 Q222 48 218 48 H4 Q0 48 0 44 Z"
                fill="var(--color-primary)"
              />
              <rect x="0" y="30" width="222" height="6" fill="var(--color-primary-deep)"/>
              <g fill="var(--color-cream)">
                <path d="M14 16 h24 a4 4 0 0 1 4 4 v6 h-32 v-6 a4 4 0 0 1 4 -4 Z"/>
                <path d="M56 16 h24 a4 4 0 0 1 4 4 v6 h-32 v-6 a4 4 0 0 1 4 -4 Z"/>
                <path d="M98 16 h24 a4 4 0 0 1 4 4 v6 h-32 v-6 a4 4 0 0 1 4 -4 Z"/>
                <path d="M140 16 h24 a4 4 0 0 1 4 4 v6 h-32 v-6 a4 4 0 0 1 4 -4 Z"/>
                <path d="M182 16 h24 a4 4 0 0 1 4 4 v6 h-32 v-6 a4 4 0 0 1 4 -4 Z"/>
              </g>
              <circle cx="34" cy="52" r="8" fill="var(--color-dark)"/>
              <circle cx="34" cy="52" r="3" fill="var(--color-cream)" opacity="0.6"/>
              <circle cx="188" cy="52" r="8" fill="var(--color-dark)"/>
              <circle cx="188" cy="52" r="3" fill="var(--color-cream)" opacity="0.6"/>
            </g>

            <!-- auto-rickshaw, flat-design: curved canopy, rounded body, spoked wheels -->
            <g class="vishesh-city-scene__rickshaw" transform="translate(-110,148)">
              <path
                d="M4 26 Q4 4 24 4 H50 Q66 4 68 20 L70 26 Z"
                fill="var(--color-accent)"
              />
              <path d="M4 26 H70 Q76 26 76 32 V38 H0 V32 Q0 26 4 26 Z" fill="var(--color-primary)"/>
              <rect x="14" y="12" width="20" height="13" rx="2" fill="var(--color-cream)" opacity="0.85"/>
              <circle cx="10" cy="30" r="4" fill="var(--color-accent)"/>
              <circle cx="18" cy="40" r="9" fill="var(--color-dark)"/>
              <circle cx="18" cy="40" r="3.4" fill="var(--color-cream)" opacity="0.7"/>
              <circle cx="60" cy="40" r="9" fill="var(--color-dark)"/>
              <circle cx="60" cy="40" r="3.4" fill="var(--color-cream)" opacity="0.7"/>
            </g>
          </svg>
        {%- when 'delhi' -%}
          <svg
            class="vishesh-city-scene__svg"
            viewBox="0 0 800 220"
            preserveAspectRatio="xMidYMax slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="vd-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--color-cream)"/>
                <stop offset="1" stop-color="#fdf7ec"/>
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="800" height="220" fill="url(#vd-sky)"/>

            <!-- Skyline, back + mid layers -->
            <g fill="var(--color-dark)" opacity="0.16">
              <rect x="0" y="108" width="36" height="72" rx="2"/>
              <rect x="46" y="120" width="24" height="60" rx="2"/>
              <rect x="700" y="112" width="30" height="68" rx="2"/>
              <rect x="748" y="124" width="30" height="56" rx="2"/>
            </g>
            <g fill="var(--color-dark)" opacity="0.3">
              <rect x="90" y="98" width="28" height="82" rx="2"/>
              <rect x="640" y="100" width="30" height="80" rx="2"/>
            </g>

            <!-- Generic gateway arch (abstract - not a specific monument) -->
            <g fill="var(--color-terracotta)">
              <rect x="330" y="70" width="18" height="110" rx="2"/>
              <rect x="452" y="70" width="18" height="110" rx="2"/>
              <path
                d="M348 118 Q348 66 400 66 Q452 66 452 118 V180 H348 Z"
                opacity="0.94"
              />
              <path d="M368 180 V128 Q368 96 400 96 Q432 96 432 128 V180 Z" fill="var(--color-cream)" opacity="0.9"/>
              <rect x="392" y="52" width="16" height="18" rx="2" fill="var(--color-terracotta)"/>
              <circle cx="400" cy="46" r="7" fill="var(--color-terracotta)"/>
              <rect x="322" y="176" width="156" height="6" fill="var(--color-dark)" opacity="0.3"/>
            </g>

            <!-- ground -->
            <rect x="0" y="180" width="800" height="2" fill="var(--color-dark)" opacity="0.25"/>

            <!-- kites, layered depth -->
            <g class="vishesh-city-scene__kite vishesh-city-scene__kite--1" transform="translate(150,52)">
              <path d="M0 -16 L16 0 L0 16 L-16 0 Z" fill="var(--color-primary)"/>
              <path d="M-16 0 H16 M0 -16 V16" stroke="var(--color-primary-deep)" stroke-width="1" opacity="0.5"/>
              <path d="M0 16 Q7 34 3 52" stroke="var(--color-dark)" stroke-width="1.4" fill="none" opacity="0.55"/>
              <circle cx="4" cy="30" r="2" fill="var(--color-accent)"/>
              <circle cx="3" cy="42" r="2" fill="var(--color-accent)"/>
            </g>
            <g class="vishesh-city-scene__kite vishesh-city-scene__kite--2" transform="translate(600,80) scale(0.8)">
              <path d="M0 -16 L16 0 L0 16 L-16 0 Z" fill="var(--color-sage)"/>
              <path d="M-16 0 H16 M0 -16 V16" stroke="var(--color-dark)" stroke-width="1" opacity="0.4"/>
              <path d="M0 16 Q-6 34 -2 52" stroke="var(--color-dark)" stroke-width="1.4" fill="none" opacity="0.55"/>
              <circle cx="-3" cy="30" r="2" fill="var(--color-accent)"/>
              <circle cx="-2" cy="42" r="2" fill="var(--color-accent)"/>
            </g>
            <g class="vishesh-city-scene__kite vishesh-city-scene__kite--3" transform="translate(670,44) scale(0.6)">
              <path d="M0 -16 L16 0 L0 16 L-16 0 Z" fill="var(--color-accent)"/>
              <path d="M0 16 Q6 34 2 52" stroke="var(--color-dark)" stroke-width="1.4" fill="none" opacity="0.5"/>
            </g>

            <!-- auto-rickshaw, same flat-design vehicle as the Mumbai scene for
                 visual consistency across cities -->
            <g class="vishesh-city-scene__rickshaw" transform="translate(-110,148)">
              <path
                d="M4 26 Q4 4 24 4 H50 Q66 4 68 20 L70 26 Z"
                fill="var(--color-accent)"
              />
              <path d="M4 26 H70 Q76 26 76 32 V38 H0 V32 Q0 26 4 26 Z" fill="var(--color-primary)"/>
              <rect x="14" y="12" width="20" height="13" rx="2" fill="var(--color-cream)" opacity="0.85"/>
              <circle cx="10" cy="30" r="4" fill="var(--color-accent)"/>
              <circle cx="18" cy="40" r="9" fill="var(--color-dark)"/>
              <circle cx="18" cy="40" r="3.4" fill="var(--color-cream)" opacity="0.7"/>
              <circle cx="60" cy="40" r="9" fill="var(--color-dark)"/>
              <circle cx="60" cy="40" r="3.4" fill="var(--color-cream)" opacity="0.7"/>
            </g>
          </svg>
        {%- when 'chilli-flakes' -%}
          {%- comment -%}
            Spice-particle treatment for Chilli Flakes (and any future
            product that opts in via the same metafield value): small
            flake fragments drift down and fade near a shallow bowl, on a
            continuous loop - CSS keyframes only, no canvas/JS, matching
            the featherweight budget of the other city-scene entries.
            Each flake is a <g> for its static X position (untouched by
            CSS) wrapping a <path> that CSS alone animates on Y/rotation -
            keeps the SVG transform attribute and the CSS transform
            animation from fighting over the same element.
          {%- endcomment -%}
          <svg
            class="vishesh-city-scene__svg"
            viewBox="0 0 800 220"
            preserveAspectRatio="xMidYMax slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="vc-sky" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="var(--color-cream)"/>
                <stop offset="1" stop-color="#fdf1e2"/>
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="800" height="220" fill="url(#vc-sky)"/>

            <!-- ground -->
            <rect x="0" y="178" width="800" height="2" fill="var(--color-dark)" opacity="0.25"/>

            <!-- shallow bowl catching the flakes -->
            <g>
              <ellipse cx="400" cy="182" rx="118" ry="14" fill="var(--color-dark)" opacity="0.12"/>
              <path
                d="M292 168 Q292 200 400 200 Q508 200 508 168 Z"
                fill="var(--color-cream)"
                stroke="var(--color-dark)"
                stroke-width="2"
                opacity="0.9"
              />
              <ellipse cx="400" cy="168" rx="108" ry="12" fill="none" stroke="var(--color-dark)" stroke-width="2" opacity="0.5"/>
              <ellipse cx="400" cy="170" rx="70" ry="6" fill="var(--color-terracotta)" opacity="0.35"/>
            </g>

            <!-- drifting flakes, staggered position/delay/duration for a natural, non-repeating feel -->
            <g transform="translate(96,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--1" d="M0 0 L9 -3 L12 5 L4 10 L-4 6 Z" fill="var(--color-terracotta)"/>
            </g>
            <g transform="translate(190,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--2" d="M0 0 L7 -4 L11 3 L5 9 L-3 5 Z" fill="var(--color-primary)"/>
            </g>
            <g transform="translate(268,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--3" d="M0 0 L8 -2 L10 6 L3 9 L-4 4 Z" fill="var(--color-accent)"/>
            </g>
            <g transform="translate(350,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--4" d="M0 0 L9 -3 L12 5 L4 10 L-4 6 Z" fill="var(--color-terracotta)"/>
            </g>
            <g transform="translate(430,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--5" d="M0 0 L7 -4 L11 3 L5 9 L-3 5 Z" fill="var(--color-primary)"/>
            </g>
            <g transform="translate(510,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--6" d="M0 0 L8 -2 L10 6 L3 9 L-4 4 Z" fill="var(--color-terracotta)"/>
            </g>
            <g transform="translate(590,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--7" d="M0 0 L9 -3 L12 5 L4 10 L-4 6 Z" fill="var(--color-accent)"/>
            </g>
            <g transform="translate(670,0)">
              <path class="vishesh-chilli-flake vishesh-chilli-flake--8" d="M0 0 L7 -4 L11 3 L5 9 L-3 5 Z" fill="var(--color-primary)"/>
            </g>
          </svg>
      {%- endcase -%}
    </div>
  </div>
{%- endif -%}
