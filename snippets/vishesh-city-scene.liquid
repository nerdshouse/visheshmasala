{% comment %}
  Playful, illustrated "city scene" strip for the product page - an
  associative styling device (this dish is often eaten in X city), not a
  factual origin claim. Set per product via the "custom.city_theme"
  metafield (single line text, e.g. "mumbai" or "delhi"). Renders nothing
  when unset or unrecognised - no forced placeholder.

  Registry pattern: to add a third city, drop in one more {%- when -%}
  block below with its own inline SVG and a matching CSS block in
  vishesh-sections.css (.vishesh-city-scene--<key> ...). Vector line-art
  only, brand palette, no photography, no trademarked monument renders.

  The suggested product -> city mapping (Pavbhaji/Frankie -> Mumbai, a
  Punjabi-style masala -> Delhi, etc.) is a starting guess flagged for the
  brand to confirm before launch, same as other placeholder facts in this
  project - see CLAUDE.md.

  Accepts: product (required)
{% endcomment %}

{%- assign city = product.metafields.custom.city_theme.value | default: '' | downcase | strip -%}

{%- if city == 'mumbai' or city == 'delhi' -%}
  <div class="vishesh-city-scene vishesh-city-scene--{{ city }}" data-animate="fade-up">
    <div class="page-width vishesh-city-scene__header">
      <p class="vishesh-city-scene__caption">
        {%- if city == 'mumbai' -%}
          A taste that feels like Mumbai's streets
        {%- else -%}
          A taste that feels like Delhi's galis
        {%- endif -%}
      </p>
    </div>
    <div class="vishesh-city-scene__stage" aria-hidden="true">
      {%- case city -%}
        {%- when 'mumbai' -%}
          <svg
            class="vishesh-city-scene__svg"
            viewBox="0 0 800 220"
            preserveAspectRatio="xMidYMax slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect x="0" y="0" width="800" height="220" fill="var(--color-cream)"/>
            <g fill="var(--color-dark)" opacity="0.55">
              <rect x="10" y="70" width="46" height="110"/>
              <rect x="66" y="40" width="34" height="140"/>
              <rect x="110" y="90" width="52" height="90"/>
              <rect x="172" y="55" width="30" height="125"/>
              <rect x="640" y="60" width="36" height="120"/>
              <rect x="682" y="95" width="50" height="85"/>
              <rect x="738" y="35" width="30" height="145"/>
              <rect x="774" y="75" width="26" height="105"/>
            </g>
            <line x1="0" y1="180" x2="800" y2="180" stroke="var(--color-dark)" stroke-width="2" opacity="0.35"/>
            <g class="vishesh-city-scene__train" transform="translate(-160,150)">
              <rect x="0" y="0" width="150" height="26" rx="4" fill="var(--color-primary)"/>
              <rect x="8" y="6" width="18" height="12" rx="2" fill="var(--color-cream)"/>
              <rect x="32" y="6" width="18" height="12" rx="2" fill="var(--color-cream)"/>
              <rect x="56" y="6" width="18" height="12" rx="2" fill="var(--color-cream)"/>
              <rect x="80" y="6" width="18" height="12" rx="2" fill="var(--color-cream)"/>
              <rect x="104" y="6" width="18" height="12" rx="2" fill="var(--color-cream)"/>
              <circle cx="20" cy="28" r="6" fill="var(--color-dark)"/>
              <circle cx="130" cy="28" r="6" fill="var(--color-dark)"/>
            </g>
            <g class="vishesh-city-scene__rickshaw" transform="translate(-90,170)">
              <path d="M2 22 Q2 4 22 4 H50 Q64 4 64 20 V26 H2 Z" fill="var(--color-accent)"/>
              <rect x="0" y="24" width="66" height="8" rx="2" fill="var(--color-dark)"/>
              <circle cx="14" cy="34" r="7" fill="var(--color-dark)"/>
              <circle cx="52" cy="34" r="7" fill="var(--color-dark)"/>
              <rect x="24" y="10" width="18" height="12" fill="var(--color-cream)" opacity="0.8"/>
            </g>
          </svg>
        {%- when 'delhi' -%}
          <svg
            class="vishesh-city-scene__svg"
            viewBox="0 0 800 220"
            preserveAspectRatio="xMidYMax slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <rect x="0" y="0" width="800" height="220" fill="var(--color-cream)"/>
            <g fill="var(--color-dark)" opacity="0.5">
              <rect x="20" y="90" width="40" height="90"/>
              <rect x="70" y="60" width="30" height="120"/>
              <rect x="700" y="75" width="34" height="105"/>
              <rect x="744" y="50" width="30" height="130"/>
            </g>
            <g fill="var(--color-terracotta)" opacity="0.65">
              <path d="M350 180 V110 Q350 90 380 90 H420 Q450 90 450 110 V180 Z"/>
              <rect x="330" y="176" width="140" height="10"/>
              <rect x="392" y="60" width="16" height="34"/>
              <circle cx="400" cy="56" r="8"/>
            </g>
            <line x1="0" y1="180" x2="800" y2="180" stroke="var(--color-dark)" stroke-width="2" opacity="0.35"/>
            <g class="vishesh-city-scene__kite vishesh-city-scene__kite--1" transform="translate(140,50)">
              <path d="M0 -14 L14 0 L0 14 L-14 0 Z" fill="var(--color-primary)"/>
              <path d="M0 14 Q6 30 2 46" stroke="var(--color-dark)" stroke-width="1.4" fill="none" opacity="0.6"/>
            </g>
            <g class="vishesh-city-scene__kite vishesh-city-scene__kite--2" transform="translate(600,80)">
              <path d="M0 -12 L12 0 L0 12 L-12 0 Z" fill="var(--color-sage)"/>
              <path d="M0 12 Q-5 26 -1 40" stroke="var(--color-dark)" stroke-width="1.4" fill="none" opacity="0.6"/>
            </g>
            <g class="vishesh-city-scene__rickshaw" transform="translate(-90,170)">
              <path d="M2 22 Q2 4 22 4 H50 Q64 4 64 20 V26 H2 Z" fill="var(--color-accent)"/>
              <rect x="0" y="24" width="66" height="8" rx="2" fill="var(--color-dark)"/>
              <circle cx="14" cy="34" r="7" fill="var(--color-dark)"/>
              <circle cx="52" cy="34" r="7" fill="var(--color-dark)"/>
              <rect x="24" y="10" width="18" height="12" fill="var(--color-cream)" opacity="0.8"/>
            </g>
          </svg>
      {%- endcase -%}
    </div>
  </div>
{%- endif -%}
