          {%- endcomment -%}
          <svg
            class="vishesh-city-scene__svg"
            viewBox="0 0 800 220"
            preserveAspectRatio="xMidYMax slice"
            xmlns="http://www.w3.org/2000/svg"
          >
            <defs>
              <linearGradient id="vb2-sky" x1="0" y1="0" x2="0" y2="1">
