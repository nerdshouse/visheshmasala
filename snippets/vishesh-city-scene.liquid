            <g fill="var(--color-terracotta)">
              <path d="M120 180 L680 180 L620 150 L180 150 Z" opacity="0.45"/>
              <path d="M180 150 L620 150 L560 122 L240 122 Z" opacity="0.58"/>
              <path d="M240 122 L560 122 L500 96 L300 96 Z" opacity="0.72"/>
              <path d="M300 96 Q300 68 400 68 Q500 68 500 96 Z" opacity="0.9"/>
