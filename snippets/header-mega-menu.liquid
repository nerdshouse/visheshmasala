{% comment %}
  Renders the header nav. Items with children (currently only "Shop") get
  the two-column mega menu: a left column of category links, and a right
  panel of quick product links per category, each with a small circular
  image badge. Structure is cloned from zeroharm.in's Shop mega menu
  (layout/restraint only - reskinned in Vishesh's own palette, no copy or
  photography borrowed). Items without children render as plain links.

  Right-panel links pull the first 4 products from the category's own
  collection (childlink.object is the Collection when the menu link points
  at one), so they stay in sync with real inventory automatically instead
  of being hand-curated.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    {%- for link in section.settings.menu.links -%}
      <li>
        {%- if link.links != blank -%}
          <header-menu>
            <details id="Details-HeaderMenu-{{ forloop.index }}" class="mega-menu vishesh-mega">
              <summary
                id="HeaderMenu-{{ link.handle }}"
                class="header__menu-item list-menu__item link focus-inset"
              >
                <span
                  {%- if link.child_active %}
                    class="header__active-menu-item"
                  {% endif %}
                >
                  {{- link.title | escape -}}
                </span>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div
                id="MegaMenu-Content-{{ forloop.index }}"
                class="vishesh-mega__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup"
                tabindex="-1"
              >
                <div class="page-width vishesh-mega__grid">
                  <ul class="vishesh-mega__categories" role="list">
                    {%- for childlink in link.links -%}
                      <li>
                        <a
                          id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                          href="{{ childlink.url }}"
                          class="vishesh-mega__category-link{% if forloop.first %} is-active{% endif %}{% if childlink.current %} mega-menu__link--active{% endif %}"
                          data-mega-category="{{ forloop.index0 }}"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          <span>{{ childlink.title | escape }}</span>
                          {{- 'icon-caret.svg' | inline_asset_content -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                  <div class="vishesh-mega__panels">
                    {%- for childlink in link.links -%}
                      {%- assign cat_collection = childlink.object -%}
                      <div
                        class="vishesh-mega__panel{% if forloop.first %} is-active{% endif %}"
                        data-mega-panel="{{ forloop.index0 }}"
                      >
                        <div class="vishesh-mega__quicklinks">
                          {%- if cat_collection != blank and cat_collection.products.size > 0 -%}
                            {%- for product in cat_collection.products limit: 4 -%}
                              <a
                                id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ product.handle }}"
                                href="{{ product.url }}"
                                class="vishesh-mega__quicklink"
                              >
                                <span class="vishesh-mega__quicklink-badge">
                                  {%- if product.featured_image -%}
                                    {{
                                      product.featured_image
                                      | image_url: width: 80
                                      | image_tag: loading: 'lazy', widths: '40, 80', alt: product.title
                                    }}
                                  {%- else -%}
                                    {{- 'icon-box.svg' | inline_asset_content -}}
                                  {%- endif -%}
                                </span>
                                <span class="vishesh-mega__quicklink-label">{{ product.title }}</span>
                              </a>
                            {%- endfor -%}
                          {%- endif -%}
                        </div>
                        <a href="{{ childlink.url }}" class="vishesh-mega__viewall">
                          {{ 'sections.featured_collection.view_all' | t }}
                          {{- 'icon-arrow.svg' | inline_asset_content -}}
                        </a>
                      </div>
                    {%- endfor -%}
                  </div>
                </div>
              </div>
            </details>
          </header-menu>
        {%- else -%}
          <a
            id="HeaderMenu-{{ link.handle }}"
            href="{{ link.url }}"
            class="header__menu-item list-menu__item link link--text focus-inset"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            <span
              {%- if link.current %}
                class="header__active-menu-item"
              {% endif %}
            >
              {{- link.title | escape -}}
            </span>
          </a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>
