{% comment %}
  Era motif for one Our Journey milestone, drawn inside the card's pin.

  Line SVG on currentColor - no image request and nothing to lazy-load,
  which matters on this theme's India-first mobile budget. Decorative
  only: the milestone's year and copy carry the meaning, so every icon is
  aria-hidden and the section reads the same with images off.

  Accepts:
  - icon: {String} one of the keys below (from the block's icon setting)

  Usage:
  {% render 'vishesh-timeline-icon', icon: block.settings.icon %}
{% endcomment %}
<svg
  class="vishesh-timeline__icon"
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'factory' -%}
      <path d="M9 38V23l9 5.5V23l9 5.5V13h12v25z" />
      <path d="M8 38h32" />
    {%- when 'cart' -%}
      <circle cx="17" cy="33" r="4.5" />
      <circle cx="32" cy="33" r="4.5" />
      <path d="M11 23h27l-3 5H14z" />
      <path d="M38 23l5-5" />
    {%- when 'people' -%}
      <circle cx="19" cy="18" r="5" />
      <circle cx="32" cy="20" r="4" />
      <path d="M9 37c0-5.5 4.5-9 10-9s10 3.5 10 9" />
      <path d="M29 37c0-4 3-6.5 6.5-6.5S42 33 42 37" />
    {%- when 'certificate' -%}
      <rect x="9" y="10" width="27" height="19" rx="2" />
      <path d="M15 17h15M15 23h9" />
      <circle cx="33" cy="33" r="6" />
      <path d="M30.5 33.2l2 2 3.6-4.2" />
    {%- when 'pack' -%}
      <path d="M15 15h18v21a3 3 0 0 1-3 3H18a3 3 0 0 1-3-3z" />
      <path d="M15 15l2.5-5h13L33 15" />
      <path d="M20 25h8" />
    {%- when 'network' -%}
      <circle cx="24" cy="24" r="4" />
      <circle cx="11" cy="12" r="3.5" />
      <circle cx="37" cy="12" r="3.5" />
      <circle cx="24" cy="40" r="3.5" />
      <path d="M21.2 21.2l-7.4-6.6M26.8 21.2l7.4-6.6M24 28v8" />
    {%- when 'star' -%}
      <path d="M24 8l4.9 10.5 11.3 1.4-8.4 7.8 2.2 11.3L24 33.4l-10 5.6 2.2-11.3-8.4-7.8 11.3-1.4z" />
    {%- when 'facility' -%}
      <path d="M9 39V17l15-8 15 8v22z" />
      <path d="M18 39V27h12v12" />
      <path d="M17 20h4M27 20h4" />
    {%- else -%}
      {%- comment -%} tin: the 15kg Hing tin the story starts with {%- endcomment -%}
      <rect x="13" y="15" width="22" height="24" rx="2.5" />
      <path d="M11 10h26v5H11z" />
      <path d="M19 24h10M19 30h7" />
  {%- endcase -%}
</svg>
