{% comment %}
  Ambient cooking vignette for the footer brand-seal column: a kadhai over
  a flame with a ladle stirring and steam curling off it.

  Replaces the Phase 16 .vishesh-seal__steam flourish, which was three
  0.25rem wisps at 0.45 opacity - technically animating, but small enough
  that it read as a rendering artefact rather than a deliberate touch.

  Lives in the seal column rather than the open space beside the About and
  Help columns because those two are <details> that collapse on mobile:
  anything parked inside them disappears below 990px. The seal block is
  always rendered, so the scene survives at every width.

  Pure inline SVG plus CSS keyframes - no image request, no JS, nothing to
  lazy-load. Decorative only, so the whole thing is aria-hidden.
  Animation is gated on prefers-reduced-motion in vishesh-sections.css,
  where it degrades to a static scene (steam parked visible, no flicker).
{% endcomment %}
<div class="vishesh-cookpot" aria-hidden="true">
  <svg class="vishesh-cookpot__svg" viewBox="0 0 160 132" role="presentation" focusable="false">
    <!-- steam, rising off the rim at y=64 -->
    <g fill="none" stroke-linecap="round" stroke-width="3.4">
      <path class="vishesh-cookpot__steam vishesh-cookpot__steam--1" d="M60 58c-7-9 5-14-1-23" />
      <path class="vishesh-cookpot__steam vishesh-cookpot__steam--2" d="M80 54c-8-11 6-17-1-28" />
      <path class="vishesh-cookpot__steam vishesh-cookpot__steam--3" d="M100 58c-7-9 5-14-1-23" />
    </g>

    <!-- masala in the pan, then the kadhai body over it -->
    <path d="M46 72q34 17 68 0q-34 8-68 0z" fill="var(--color-orange, #f99e3d)" />
    <path d="M41 70q39 44 78 0z" fill="#3f2c17" />
    <rect x="36" y="64" width="88" height="7" rx="3.5" fill="#5c4422" />
    <circle cx="31" cy="67.5" r="5.4" fill="none" stroke="#5c4422" stroke-width="4" />
    <circle cx="129" cy="67.5" r="5.4" fill="none" stroke="#5c4422" stroke-width="4" />

    <!-- ladle last so the stir stays visible above the masala -->
    <g class="vishesh-cookpot__ladle">
      <line x1="104" y1="38" x2="88" y2="74" stroke="#e4d4b6" stroke-width="4.2" stroke-linecap="round" />
      <ellipse cx="86" cy="77" rx="7.5" ry="4.2" fill="#e4d4b6" transform="rotate(-24 86 77)" />
    </g>

    <!-- flame, tucked under the bowl -->
    <g class="vishesh-cookpot__flame-group">
      <path
        class="vishesh-cookpot__flame--outer"
        d="M80 92c7 9 11 12 11 17a11 11 0 0 1-22 0c0-5 4-8 11-17z"
        fill="var(--color-accent, #ffc50a)"
      />
      <path
        class="vishesh-cookpot__flame--inner"
        d="M80 101c3.5 4.5 5.5 6.5 5.5 9a5.5 5.5 0 0 1-11 0c0-2.5 2-4.5 5.5-9z"
        fill="#ffffff"
        opacity="0.72"
      />
    </g>
  </svg>
</div>
